@baseUrl = http://localhost:5165/api
@contentType = application/json


### Create Borrow
POST {{baseUrl}}/Borrows/borrow
Content-Type: {{contentType}}

{
    "clientId": 2,
    "copyId": 1
}

### Return Borrow
POST {{baseUrl}}/Borrows/return
Content-Type: {{contentType}}

{
    "borrowingId": 3,
    "copyId": 1
}

### Get Full Borrow Details
GET {{baseUrl}}/Borrows/client/1
Content-Type: {{contentType}}

{
    "pageNumber": 1,
    "pageSize": 10,
    "clientId": 1
}