@baseUrl = http://localhost:5165/api
@contentType = application/json


### Create Borrow
POST {{baseUrl}}/Borrows/borrow
Content-Type: {{contentType}}

{
    "clientId": 1,
    "copyId": 1
}

### Return Borrow
POST {{baseUrl}}/Borrows/return
Content-Type: {{contentType}}

{
    "borrowingId": 3,
    "copyId": 1
}

### Get Full Borrow Details
GET {{baseUrl}}/Borrows/get-full-borrow-details?PageNumber=1&PageSize=10
Content-Type: {{contentType}}